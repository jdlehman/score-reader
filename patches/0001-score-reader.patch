+        final int lookup = scale.toPixels(constants.leftLineLookup);
+        final int maxWidth = Math.max(2, scale.toPixels(constants.leftLineMaxWidth));
+        final int maxGap = scale.toPixels(constants.leftLineMaxGap);
+        final double maxWhite = constants.leftLineMaxWhiteRatio.getValue();
+
+        for (int i = 1; i < systemTops.length; i++) {
+            if (systemTops[i].equals(systemTops[i - 1])) {
+                continue;
+            }
+
+            final Staff above = staffManager.getStaff(i - 1);
+            final Staff below = staffManager.getStaff(i);
+            final int aboveLeft = above.getAbscissa(LEFT);
+            final int belowLeft = below.getAbscissa(LEFT);
+            final int yTop = above.getLastLine().yAt(aboveLeft);
+            final int yBottom = below.getFirstLine().yAt(belowLeft);
+
+            if (yBottom <= yTop) {
+                continue;
+            }
+
+            final int xMax = Math.min(binary.getWidth() - 2, Math.min(aboveLeft, belowLeft) + scale.getInterline());
+            final int xMin = Math.max(1, Math.min(aboveLeft, belowLeft) - lookup);
