+package org.audiveris.omr.text;
+
+import org.audiveris.omr.sheet.Sheet;
+
+import java.awt.Point;
+import java.awt.Rectangle;
+import java.awt.geom.Line2D;
+import java.awt.image.BufferedImage;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.SortedSet;
+import java.util.TreeSet;
+
+/**
+ * Score Reader: OCR in the browser. Tesseract's native code can't run in CheerpJ, so the web page
+ * reads the text with tesseract.js (the same Tesseract, compiled to WebAssembly, running the legacy
+ * engine as TesseractOrder does) and hands back its lines, words and characters.
+ * <p>
+ * Tesseract.js gives no font attributes, so each word gets a plain font whose size comes from its
+ * line's height; TextWord fits the size to the word's bounds anyway.
+ */
+public final class BrowserOCR
+        implements OCR
+{
+    private static final BrowserOCR INSTANCE = new BrowserOCR();
+
+    /** The languages the page has data for (the pick panel's selector, app/language.js). */
+    private static final SortedSet<String> LANGUAGES = Collections.unmodifiableSortedSet(
+            new TreeSet<>(List.of("deu", "eng", "fra", "ita", "lat", "spa")));
+
+    /** Tesseract's page segmentation modes, as TesseractOCR uses them. */
+    private static final int PSM_AUTO = 3;
+
+    private static final int PSM_SINGLE_BLOCK = 6;
+
+    private BrowserOCR ()
+    {
+    }
+
+    public static BrowserOCR getInstance ()
+    {
+        return INSTANCE;
+    }
+
+    /**
+     * Implemented by the web page (a CheerpJ native): read the text in a grey image.
+     *
+     * @return one line per item, in order: "L x0 y0 x1 y1 bx0 by0 bx1 by1 height" for a text line
+     *         (its bounds, baseline and row height), "W x0 y0 x1 y1 confidence text" for each of
+     *         its words, and "C x0 y0 x1 y1 text" for each of a word's characters
+     */
+    private static native String read (byte[] grey,
+                                       int width,
+                                       int height,
+                                       String languages,
+                                       int pageSegMode);
+
+    @Override
+    public SortedSet<String> getSupportedLanguages ()
+    {
+        return LANGUAGES;
+    }
+
+    @Override
+    public double getMinConfidence ()
+    {
+        return 0.65; // as TesseractOCR
+    }
+
+    @Override
+    public String identify ()
+    {
+        return "Tesseract (tesseract.js), in the browser";
+    }
+
+    @Override
+    public boolean isAvailable ()
+    {
+        return true;
+    }
+
+    @Override
+    public boolean supports (String langSpec)
+    {
+        final List<String> codes = (langSpec == null) ? List.of() : Language.codesOf(langSpec);
+        return !codes.isEmpty() && LANGUAGES.containsAll(codes);
+    }
+
+    @Override
+    public List<TextLine> recognize (Sheet sheet,
+                                     BufferedImage image,
+                                     Point topLeft,
+                                     String langSpec,
+                                     LayoutMode layoutMode,
+                                     String label)
+    {
+        final int width = image.getWidth();
+        final int height = image.getHeight();
+        BufferedImage grey = image;
+
+        if (image.getType() != BufferedImage.TYPE_BYTE_GRAY) {
+            grey = new BufferedImage(width, height, BufferedImage.TYPE_BYTE_GRAY);
+            grey.createGraphics().drawImage(image, 0, 0, null);
+        }
+
+        final byte[] pixels = (byte[]) grey.getRaster().getDataElements(0, 0, width, height, null);
+        final int mode = (layoutMode == LayoutMode.SINGLE_BLOCK) ? PSM_SINGLE_BLOCK : PSM_AUTO;
+        final List<TextLine> lines = parse(sheet, read(pixels, width, height, langSpec, mode));
+
+        if (topLeft != null) {
+            for (TextLine line : lines) {
+                line.translate(topLeft.x, topLeft.y);
+            }
+        }
+
+        return lines;
+    }
+
+    private static Rectangle box (String[] f)
+    {
+        final int x0 = Integer.parseInt(f[1]);
+        final int y0 = Integer.parseInt(f[2]);
+        return new Rectangle(x0, y0, Integer.parseInt(f[3]) - x0, Integer.parseInt(f[4]) - y0);
+    }
+
+    /** The page's answer as Audiveris's lines, words and characters, as TesseractOrder builds them. */
+    private static List<TextLine> parse (Sheet sheet,
+                                         String answer)
+    {
+        final List<TextLine> lines = new ArrayList<>();
+        TextLine line = null;
+        TextWord word = null;
+        Line2D baseline = null;
+        int pointSize = 10;
+
+        for (String row : answer.split("\n")) {
+            if (row.isEmpty()) {
+                continue;
+            }
+
+            switch (row.charAt(0)) {
+            case 'L' -> {
+                final String[] f = row.split(" ");
+                line = new TextLine(sheet);
+                lines.add(line);
+                baseline = new Line2D.Double(
+                        Integer.parseInt(f[5]),
+                        Integer.parseInt(f[6]),
+                        Integer.parseInt(f[7]),
+                        Integer.parseInt(f[8]));
+                pointSize = Math.max(1, Integer.parseInt(f[9]));
+                word = null;
+            }
+
+            case 'W' -> {
+                final String[] f = row.split(" ", 7);
+                if (line == null || f.length < 7) {
+                    continue;
+                }
+                word = new TextWord(
+                        sheet,
+                        box(f),
+                        f[6],
+                        baseline,
+                        Integer.parseInt(f[5]) / 100.0,
+                        new FontInfo(false, false, pointSize, null),
+                        line);
+                line.appendWord(word);
+            }
+
+            case 'C' -> {
+                final String[] f = row.split(" ", 6);
+                if (word == null || f.length < 6) {
+                    continue;
+                }
+                final Rectangle bounds = box(f);
+                final String value = f[5];
+                final int len = value.length();
+
+                if (len == 1) {
+                    word.addChar(new TextChar(bounds, value));
+                } else {
+                    // several characters in one symbol: share the width, as TesseractOrder does
+                    final double each = (double) bounds.width / len;
+                    for (int i = 0; i < len; i++) {
+                        word.addChar(new TextChar(
+                                new Rectangle(
+                                        (int) Math.round(bounds.x + i * each),
+                                        bounds.y,
+                                        (int) Math.round(each),
+                                        bounds.height),
+                                value.substring(i, i + 1)));
+                    }
+                }
+            }
+
+            default -> {
+            }
+            }
+        }
+
+        lines.removeIf(l -> l.getValue().isBlank());
+
+        return lines;
+    }
+}
